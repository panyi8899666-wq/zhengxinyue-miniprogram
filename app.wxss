/* 全局样式 · 墨黑 / 炭灰 / 象牙白 / 香槟金 · 克制高级暗色 */
page {
  background-color: #0D0D0F;
  color: #ECEAE4;
  font-size: 28rpx;
  line-height: 1.7;
  font-family: 'Microsoft YaHei', '微软雅黑', -apple-system, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
}

view, text, scroll-view, swiper, image {
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 0 32rpx 48rpx;
  background-color: #0D0D0F;
}

/* 英文眉题：只出现在结构性位置 */
.eyebrow {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: #C6A15B;
  margin-bottom: 16rpx;
}

/* 分节标题 */
.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ECEAE4;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 26rpx;
  color: rgba(236, 234, 228, 0.62);
  margin-bottom: 28rpx;
}

/* 卡片 */
.card {
  background-color: #141416;
  border: 1rpx solid rgba(236, 234, 228, 0.1);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 金色小标签 */
.tag-gold {
  display: inline-block;
  font-size: 22rpx;
  color: #C6A15B;
  border: 1rpx solid rgba(198, 161, 91, 0.45);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

/* 灰色标签 */
.tag-gray {
  display: inline-block;
  font-size: 22rpx;
  color: rgba(236, 234, 228, 0.7);
  border: 1rpx solid rgba(236, 234, 228, 0.2);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

/* 主按钮：香槟金实底 */
.btn-primary {
  background-color: #C6A15B;
  color: #0D0D0F;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 12rpx;
  padding: 24rpx 0;
  margin-top: 24rpx;
  letter-spacing: 2rpx;
}

.btn-primary .btn-en {
  display: block;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  margin-top: 6rpx;
  opacity: 0.75;
}

/* 次按钮：描边 */
.btn-outline {
  border: 1rpx solid rgba(198, 161, 91, 0.6);
  color: #C6A15B;
  font-size: 28rpx;
  text-align: center;
  border-radius: 12rpx;
  padding: 22rpx 0;
  margin-top: 20rpx;
  letter-spacing: 2rpx;
}

.btn-outline .btn-en {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  margin-top: 6rpx;
  opacity: 0.7;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: rgba(236, 234, 228, 0.1);
  margin: 40rpx 0;
}

/* 占位图块（图片地址未填时显示） */
.img-placeholder {
  background-color: #141416;
  border: 1rpx dashed rgba(198, 161, 91, 0.4);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
}

.img-placeholder text {
  font-size: 24rpx;
  color: rgba(198, 161, 91, 0.75);
  letter-spacing: 2rpx;
  text-align: center;
  padding: 0 24rpx;
}
