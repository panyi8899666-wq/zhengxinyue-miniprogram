/* 联系页 */
.contact-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(236, 234, 228, 0.08);
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-info {
  flex: 1;
  margin-right: 20rpx;
}

.contact-value {
  display: block;
  font-size: 30rpx;
  color: #ECEAE4;
  letter-spacing: 1rpx;
}

.contact-label {
  display: block;
  font-size: 24rpx;
  color: rgba(236, 234, 228, 0.5);
  margin-top: 6rpx;
}

.copy-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #C6A15B;
  border: 1rpx solid rgba(198, 161, 91, 0.5);
  border-radius: 8rpx;
  padding: 12rpx 26rpx;
}

.copy-btn.gold {
  background-color: #C6A15B;
  color: #0D0D0F;
  border-color: #C6A15B;
  font-weight: 600;
}

.qr-box {
  min-height: 380rpx;
  margin-top: 8rpx;
}

.qr-img {
  width: 100%;
  display: block;
}

.qr-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 8rpx;
}

.qr-box.half {
  width: 48%;
  min-height: 300rpx;
}

/* 表单 */
.form-label {
  display: block;
  font-size: 26rpx;
  color: #C6A15B;
  letter-spacing: 2rpx;
  margin: 24rpx 0 12rpx;
}

.picker-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #0D0D0F;
  border: 1rpx solid rgba(236, 234, 228, 0.2);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #ECEAE4;
}

.picker-arrow {
  color: #C6A15B;
  font-size: 34rpx;
}

.form-input {
  background-color: #0D0D0F;
  border: 1rpx solid rgba(236, 234, 228, 0.2);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #ECEAE4;
  width: 100%;
}

.form-textarea {
  background-color: #0D0D0F;
  border: 1rpx solid rgba(236, 234, 228, 0.2);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #ECEAE4;
  width: 100%;
  height: 220rpx;
  line-height: 1.7;
}

.brief-card {
  border-color: rgba(198, 161, 91, 0.4);
}

.brief-text {
  display: block;
  font-size: 28rpx;
  color: rgba(236, 234, 228, 0.85);
  line-height: 2;
  background-color: #0D0D0F;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin: 12rpx 0 4rpx;
  white-space: pre-wrap;
}
