/* 首页 */
.hero {
  padding: 48rpx 0 12rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #ECEAE4;
  margin-bottom: 20rpx;
}

.status-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #C6A15B;
  margin-right: 14rpx;
}

.status-text {
  font-size: 26rpx;
  color: #C6A15B;
  letter-spacing: 2rpx;
}

.hero-slogan {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #ECEAE4;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.hero-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(236, 234, 228, 0.62);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.hero-cta {
  margin-top: 12rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24rpx;
}

.more-link {
  font-size: 26rpx;
  color: #C6A15B;
  letter-spacing: 1rpx;
  padding: 12rpx 0 12rpx 24rpx;
}

.featured-scroll {
  width: 100%;
  margin: 0 -32rpx;
  padding: 0 32rpx;
}

.featured-row {
  display: flex;
  flex-direction: row;
}

.featured-card {
  width: 480rpx;
  margin-right: 24rpx;
  background-color: #141416;
  border: 1rpx solid rgba(236, 234, 228, 0.1);
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.featured-img {
  width: 480rpx;
  height: 320rpx;
}

.featured-meta {
  padding: 20rpx 24rpx 24rpx;
}

.featured-cat {
  display: block;
  font-size: 22rpx;
  color: #C6A15B;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}

.featured-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #ECEAE4;
  margin-bottom: 10rpx;
}

.price-card .price-row {
  display: flex;
  align-items: baseline;
  margin: 12rpx 0;
}

.price-big {
  font-size: 56rpx;
  font-weight: 700;
  color: #ECEAE4;
  letter-spacing: 2rpx;
  margin-right: 20rpx;
}

.price-usd {
  font-size: 22rpx;
  color: rgba(236, 234, 228, 0.55);
  letter-spacing: 2rpx;
}

.cta-block {
  background-color: #141416;
  border: 1rpx solid rgba(198, 161, 91, 0.3);
  border-radius: 16rpx;
  padding: 36rpx 28rpx;
  margin-top: 12rpx;
  text-align: center;
}

.cta-block .section-desc {
  margin-bottom: 8rpx;
}
