/* 首页 */
.hero {
  padding: 56rpx 0 16rpx;
  text-align: center;
}

.hero-kicker {
  display: block;
  font-size: 28rpx;
  color: #ECEAE4;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.hero-kicker-en {
  display: block;
  font-size: 20rpx;
  color: rgba(236, 234, 228, 0.5);
  letter-spacing: 6rpx;
  margin-bottom: 36rpx;
}

.hero-title-block {
  margin-bottom: 24rpx;
  transform: skewY(-2deg);
}

.hero-line1, .hero-line2 {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #ECEAE4;
  letter-spacing: 4rpx;
  line-height: 1.4;
  font-family: 'Microsoft YaHei', '微软雅黑', sans-serif;
}

.hero-line1 .gold, .hero-line2 .gold {
  color: #C6A15B;
}

.hero-en {
  display: block;
  font-size: 20rpx;
  color: rgba(236, 234, 228, 0.45);
  letter-spacing: 2rpx;
  line-height: 1.8;
  margin-bottom: 20rpx;
  padding: 0 16rpx;
}

.hero-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(236, 234, 228, 0.7);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.hero-cta {
  margin: 28rpx 0;
}

.hero-cta .btn-primary {
  margin-top: 0;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #C6A15B;
  margin-right: 14rpx;
}

.status-text {
  font-size: 26rpx;
  color: #C6A15B;
  letter-spacing: 2rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24rpx;
}

.section-en {
  display: block;
  font-size: 20rpx;
  color: rgba(236, 234, 228, 0.4);
  letter-spacing: 5rpx;
  margin-top: 6rpx;
}

.more-link {
  font-size: 26rpx;
  color: #C6A15B;
  letter-spacing: 1rpx;
  padding: 12rpx 0 12rpx 24rpx;
}

.section-tip {
  display: block;
  font-size: 22rpx;
  color: rgba(236, 234, 228, 0.4);
  text-align: center;
  margin-top: 16rpx;
  letter-spacing: 2rpx;
}

.featured-scroll {
  width: 100%;
  margin: 0 -32rpx;
  padding: 0 32rpx;
}

.featured-row {
  display: flex;
  flex-direction: row;
}

.featured-card {
  width: 440rpx;
  margin-right: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
}

.featured-img {
  width: 440rpx;
  height: 300rpx;
  border-radius: 16rpx;
}

.card-tag {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
}

/* 从策略到落地 */
.strategy-block {
  background-color: #141416;
  border: 1rpx solid rgba(236, 234, 228, 0.08);
  border-radius: 16rpx;
  padding: 36rpx 28rpx;
}

.strategy-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(236, 234, 228, 0.7);
  line-height: 1.8;
  margin: 16rpx 0 24rpx;
}

.strategy-points {
  display: flex;
  flex-direction: column;
}

.strategy-point {
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(236, 234, 228, 0.08);
}

.strategy-point-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #ECEAE4;
  margin-bottom: 8rpx;
}

.strategy-point-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(236, 234, 228, 0.55);
  line-height: 1.7;
}

/* 服务列表 */
.service-list {
  display: flex;
  flex-direction: column;
}

.service-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(236, 234, 228, 0.08);
}

.service-item:last-child {
  border-bottom: none;
}

.service-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #ECEAE4;
  margin-bottom: 8rpx;
}

.service-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(236, 234, 228, 0.55);
}

/* 时间轴 */
.about-quote {
  display: block;
  font-size: 30rpx;
  color: #ECEAE4;
  line-height: 1.8;
  margin: 16rpx 0 28rpx;
  padding-left: 24rpx;
  border-left: 4rpx solid #C6A15B;
}

.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  flex-direction: row;
  padding-bottom: 32rpx;
  position: relative;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #C6A15B;
  margin-top: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.timeline-body {
  flex: 1;
}

.timeline-period {
  display: block;
  font-size: 24rpx;
  color: #C6A15B;
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.timeline-role {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #ECEAE4;
  margin-bottom: 8rpx;
}

.timeline-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(236, 234, 228, 0.55);
  line-height: 1.7;
}

/* 价格 */
.price-card .price-row {
  display: flex;
  align-items: baseline;
  margin: 12rpx 0;
}

.price-big {
  font-size: 56rpx;
  font-weight: 700;
  color: #ECEAE4;
  letter-spacing: 2rpx;
  margin-right: 20rpx;
}

.price-usd {
  font-size: 22rpx;
  color: rgba(236, 234, 228, 0.55);
  letter-spacing: 2rpx;
}

.cta-block {
  background-color: #141416;
  border: 1rpx solid rgba(198, 161, 91, 0.3);
  border-radius: 16rpx;
  padding: 36rpx 28rpx;
  margin-top: 12rpx;
  text-align: center;
}

.cta-block .section-desc {
  margin-bottom: 8rpx;
}
