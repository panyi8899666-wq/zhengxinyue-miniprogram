/* 服务页 */
.cap-tags {
  margin-top: 14rpx;
}

.steps {
  margin-top: 8rpx;
}

.step {
  display: flex;
  flex-direction: row;
  background-color: #141416;
  border: 1rpx solid rgba(236, 234, 228, 0.1);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.step-no {
  font-size: 40rpx;
  font-weight: 700;
  color: #C6A15B;
  letter-spacing: 2rpx;
  margin-right: 24rpx;
  line-height: 1.3;
}

.step-body {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #ECEAE4;
  margin-bottom: 8rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(236, 234, 228, 0.62);
  line-height: 1.8;
}

.price-card {
  border-color: rgba(198, 161, 91, 0.35);
}

.price-row {
  display: flex;
  align-items: baseline;
  margin: 8rpx 0 12rpx;
}

.price-big {
  font-size: 60rpx;
  font-weight: 700;
  color: #ECEAE4;
  letter-spacing: 2rpx;
}

.price-sub {
  font-size: 30rpx;
  color: rgba(236, 234, 228, 0.7);
  margin-left: 12rpx;
}

.price-usd {
  display: block;
  font-size: 22rpx;
  color: rgba(236, 234, 228, 0.55);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.card-text.dim {
  color: rgba(236, 234, 228, 0.55);
  margin-top: 12rpx;
}

.faq-list {
  margin-top: 8rpx;
}

.faq-item {
  background-color: #141416;
  border: 1rpx solid rgba(236, 234, 228, 0.1);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 28rpx;
}

.faq-q-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #ECEAE4;
  margin-right: 20rpx;
}

.faq-arrow {
  font-size: 36rpx;
  color: #C6A15B;
  line-height: 1;
}

.faq-a {
  padding: 0 28rpx 28rpx;
  font-size: 28rpx;
  color: rgba(236, 234, 228, 0.72);
  line-height: 1.9;
  border-top: 1rpx solid rgba(236, 234, 228, 0.08);
  padding-top: 20rpx;
}
