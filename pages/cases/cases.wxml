<view class="container">
  <text class="section-title">作品索引</text>
  <text class="section-en">WORKS INDEX</text>
  <text class="section-desc">按类别筛选，点击图片进入详情。</text>

  <scroll-view class="filter-bar" scroll-x="true">
    <view class="filter-row">
      <text
        wx:for="{{filters}}"
        wx:key="*this"
        data-filter="{{item}}"
        bindtap="onFilterTap"
        class="filter-item {{activeFilter === item ? 'active' : ''}}"
      >{{item}}</text>
    </view>
  </scroll-view>

  <view class="case-grid">
    <view class="case-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <block wx:if="{{item.cover}}">
        <image class="case-cover" src="{{item.cover}}" mode="aspectFill"></image>
      </block>
      <block wx:else>
        <view class="img-placeholder case-cover"><text>作品图</text></view>
      </block>
      <text wx:if="{{item.isReal}}" class="tag-gold card-tag">{{item.realTag}}</text>
    </view>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">
    <text>该类别暂无案例</text>
  </view>
</view>
