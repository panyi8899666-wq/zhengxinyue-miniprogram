/* 作品索引 */
.filter-bar {
  width: 100%;
  margin: 0 -32rpx 28rpx;
  padding: 0 32rpx;
}

.filter-row {
  display: flex;
  flex-direction: row;
}

.filter-item {
  flex-shrink: 0;
  font-size: 28rpx;
  color: rgba(236, 234, 228, 0.62);
  border: 1rpx solid rgba(236, 234, 228, 0.2);
  border-radius: 40rpx;
  padding: 14rpx 34rpx;
  margin-right: 18rpx;
}

.filter-item.active {
  color: #0D0D0F;
  background-color: #C6A15B;
  border-color: #C6A15B;
  font-weight: 600;
}

.case-card {
  background-color: #141416;
  border: 1rpx solid rgba(236, 234, 228, 0.1);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.case-cover {
  width: 100%;
  height: 380rpx;
}

.case-meta {
  padding: 24rpx 28rpx 28rpx;
}

.case-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.case-cat {
  font-size: 22rpx;
  color: #C6A15B;
  letter-spacing: 3rpx;
}

.case-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #ECEAE4;
  margin-bottom: 14rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: rgba(236, 234, 228, 0.5);
  font-size: 28rpx;
}
