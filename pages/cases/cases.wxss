/* 作品索引 · 纯图卡片 */
.filter-bar {
  width: 100%;
  margin: 0 -32rpx 28rpx;
  padding: 0 32rpx;
}

.filter-row {
  display: flex;
  flex-direction: row;
}

.filter-item {
  flex-shrink: 0;
  font-size: 28rpx;
  color: rgba(236, 234, 228, 0.62);
  border: 1rpx solid rgba(236, 234, 228, 0.2);
  border-radius: 40rpx;
  padding: 14rpx 34rpx;
  margin-right: 18rpx;
}

.filter-item.active {
  color: #0D0D0F;
  background-color: #C6A15B;
  border-color: #C6A15B;
  font-weight: 600;
}

.case-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.case-card {
  width: 48.5%;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  position: relative;
}

.case-cover {
  width: 100%;
  height: 280rpx;
  border-radius: 12rpx;
}

.card-tag {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  font-size: 20rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: rgba(236, 234, 228, 0.5);
  font-size: 28rpx;
}
