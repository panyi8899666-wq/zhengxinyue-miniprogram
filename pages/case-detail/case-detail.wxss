/* 案例详情 */
.detail-cat {
  display: block;
  font-size: 24rpx;
  color: #C6A15B;
  letter-spacing: 4rpx;
  margin: 8rpx 0 12rpx;
}

.detail-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ECEAE4;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.detail-tags {
  margin-bottom: 8rpx;
}

.real-badge {
  margin: 12rpx 0 8rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #ECEAE4;
  margin-bottom: 12rpx;
}

.card-text {
  display: block;
  font-size: 28rpx;
  color: rgba(236, 234, 228, 0.78);
  line-height: 1.9;
}

.rationale-card {
  border-color: rgba(198, 161, 91, 0.35);
}

.views {
  margin-top: 8rpx;
}

.view-item {
  margin-bottom: 28rpx;
}

.view-label {
  display: block;
  font-size: 24rpx;
  color: #C6A15B;
  letter-spacing: 3rpx;
  margin-bottom: 14rpx;
}

.view-img {
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
}

view.view-img {
  min-height: 320rpx;
}
